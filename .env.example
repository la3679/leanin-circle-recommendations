# Defaults below are already applied; no .env file is required.
# To override them, set environment variables in your shell.
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./var/circles.sqlite
# Omit AS_OF to use the imported snapshot date (2026-09-21T00:00:00.000Z).
# Aggregate counts are snapshot-relative; this override does not refresh them.
AS_OF=2026-09-21T00:00:00.000Z
